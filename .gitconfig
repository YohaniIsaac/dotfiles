# Identidad personal por defecto. Los repos dentro de ~/git/ (trabajo) usan la de
# Innovex vía el includeIf del final. Un repo con user.* local sigue mandando.
[user]
	email = yohani.tripai.yt@gmail.com
	name = YohaniIsaac
[core]
	editor = nvim
	pager = delta
	excludesFile = ~/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
	pager = less -R
	width = variable
[pager]
	diff = true
[includeIf "gitdir:~/git/"]
	path = ~/.config/git/work.gitconfig
